{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@forgeai/shared": ["packages/shared/src/index.ts"],
      "@forgeai/security": ["packages/security/src/index.ts"],
      "@forgeai/tools": ["packages/tools/src/index.ts"],
      "@forgeai/providers": ["packages/providers/src/index.ts"],
      "@forgeai/agent": ["packages/agent/src/index.ts"],
      "@forgeai/context": ["packages/context/src/index.ts"],
      "@forgeai/git": ["packages/git/src/index.ts"],
      "@forgeai/terminal": ["packages/terminal/src/index.ts"],
      "@forgeai/storage": ["packages/storage/src/index.ts"]
    },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noEmit": true
  }
}
