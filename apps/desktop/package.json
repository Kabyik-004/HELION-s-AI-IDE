{
  "name": "@forgeai/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ForgeAI desktop application (Tauri shell + React UI).",
  "scripts": {
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:app && npm run typecheck:node",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@forgeai/agent": "*",
    "@forgeai/context": "*",
    "@forgeai/git": "*",
    "@forgeai/providers": "*",
    "@forgeai/security": "*",
    "@forgeai/shared": "*",
    "@forgeai/storage": "*",
    "@forgeai/terminal": "*",
    "@forgeai/tools": "*",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.2.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
